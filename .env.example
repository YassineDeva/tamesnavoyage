# The production origin, with no trailing slash.
#
# Everything search engines rely on is derived from this one value: canonical
# URLs, hreflang alternates, the sitemap, Open Graph image URLs and the
# structured data. If it does not match the domain the site is actually served
# from — apex vs www, http vs https — every one of those points at a URL that
# does not exist, and Google will not index the site correctly.
#
# Set it in the Vercel project (Production, Preview and Development) as well as
# here. Verify with: curl -s https://<domain>/sitemap.xml | head
NEXT_PUBLIC_SITE_URL=https://www.tamesnavoyages.ma
